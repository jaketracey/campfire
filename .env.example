# =============================================================================
# Project Campfire - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18.1)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://campfire:campfire_dev@localhost:5432/campfire_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Redis (Optional - for rate limiting, queues, session cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Buckets
S3_MEDIA_BUCKET=campfire-media-dev
S3_VAULT_BUCKET=campfire-vault-dev

# CloudFront (Optional)
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DOMAIN=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-change-in-production

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (fallback/alternative)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Speech-to-Text (STT) Providers
# -----------------------------------------------------------------------------
# Deepgram (recommended)
DEEPGRAM_API_KEY=

# OpenAI Whisper (alternative)
# Uses OPENAI_API_KEY above

# -----------------------------------------------------------------------------
# Text-to-Speech (TTS) Providers
# -----------------------------------------------------------------------------
# ElevenLabs (recommended)
ELEVENLABS_API_KEY=

# OpenAI TTS (alternative)
# Uses OPENAI_API_KEY above

# -----------------------------------------------------------------------------
# Image Generation Providers
# -----------------------------------------------------------------------------
# FAL AI (preferred - fast Flux inference)
FAL_API_KEY=

# Replicate (alternative)
REPLICATE_API_TOKEN=

# OpenAI DALL-E (alternative)
# Uses OPENAI_API_KEY above

# Stability AI (alternative)
STABILITY_API_KEY=

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_YEARLY=

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Google Tag Manager
GTM_CONTAINER_ID=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Service URLs (for local development)
# -----------------------------------------------------------------------------
GATEWAY_URL=http://localhost:4000
ORCHESTRATOR_URL=http://localhost:5000
WEB_URL=http://localhost:3000
MARKETING_URL=http://localhost:3001

# WebSocket
WS_PORT=4001

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_IMAGE_GENERATION=true
FEATURE_VOICE_CONVERSATIONS=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_VAULT_PROJECTION=true

# -----------------------------------------------------------------------------
# Amazon SES Email Configuration
# -----------------------------------------------------------------------------
# SES sender configuration
SES_SENDER_EMAIL=noreply@campfire.app
SES_SENDER_NAME=Campfire
SES_REPLY_TO_EMAIL=support@campfire.app

# SES region (can differ from main AWS_REGION for regional optimization)
SES_REGION=us-east-1

# Sandbox mode - limits sending to verified addresses only
SES_SANDBOX_MODE=true

# Rate limiting (SES sandbox default is 14/sec)
SES_MAX_SEND_RATE=14

# Configuration set for tracking (opens, clicks, bounces)
SES_CONFIGURATION_SET=campfire-dev-email-tracking

# SNS topic ARNs for bounce/complaint notifications
SES_BOUNCE_TOPIC_ARN=arn:aws:sns:us-east-1:932630290000:campfire-dev-email-bounces
SES_COMPLAINT_TOPIC_ARN=arn:aws:sns:us-east-1:932630290000:campfire-dev-email-complaints

# Email security and preferences
EMAIL_UNSUBSCRIBE_SECRET=your-unsubscribe-hmac-secret-change-in-production
EMAIL_TRACKING_ENABLED=true
EMAIL_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
# Enable detailed error messages
DEBUG=campfire:*

# Disable SSL verification for local development
# NODE_TLS_REJECT_UNAUTHORIZED=0
