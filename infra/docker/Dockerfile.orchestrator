# =============================================================================
# Campfire Orchestrator Service - Multi-stage Dockerfile (Python)
# =============================================================================
# Build: docker build -f infra/docker/Dockerfile.orchestrator -t campfire-orchestrator .
# Run:   docker run -p 5000:5000 campfire-orchestrator
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder - Install dependencies and build
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN pip install --no-cache-dir uv

# Copy dependency files
COPY packages/orchestrator/pyproject.toml ./
COPY packages/orchestrator/README.md ./

# Create source directory structure for editable install
COPY packages/orchestrator/src ./src

# Install dependencies using uv
RUN uv pip install --system --no-cache -e ".[dev]"

# -----------------------------------------------------------------------------
# Stage 2: Production - Minimal production image
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS production

# Security: Run as non-root user
RUN groupadd --system --gid 1001 python && \
    useradd --system --uid 1001 --gid python campfire

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv and copy dependencies from builder
RUN pip install --no-cache-dir uv

# Copy pyproject, source, and tests
COPY packages/orchestrator/pyproject.toml ./
COPY packages/orchestrator/README.md ./
COPY packages/orchestrator/src ./src
COPY packages/orchestrator/tests ./tests

# Install dependencies including pytest for test runner API
RUN uv pip install --system --no-cache -e ".[dev]"

# Set ownership
RUN chown -R campfire:python /app

# Switch to non-root user
USER campfire

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:5000/health || exit 1

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PORT=5000

CMD ["python", "-m", "uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "5000"]

# -----------------------------------------------------------------------------
# Stage 3: Development - Full development environment
# -----------------------------------------------------------------------------
FROM python:3.11-slim AS development

# Install dev dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv
RUN pip install --no-cache-dir uv

# Copy pyproject and source
COPY packages/orchestrator/pyproject.toml ./
COPY packages/orchestrator/README.md ./
COPY packages/orchestrator/src ./src

# Install all dependencies including dev
RUN uv pip install --system --no-cache -e ".[dev]"

EXPOSE 5000

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    PORT=5000

CMD ["python", "-m", "uvicorn", "orchestrator.main:app", "--host", "0.0.0.0", "--port", "5000", "--reload"]
