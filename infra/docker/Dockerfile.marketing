# =============================================================================
# Campfire Marketing Site - Multi-stage Dockerfile
# =============================================================================
# Build: docker build -f infra/docker/Dockerfile.marketing -t campfire-marketing .
# Run:   docker run -p 3001:3001 campfire-marketing
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base - Common dependencies and setup
# -----------------------------------------------------------------------------
FROM node:22-alpine AS base

RUN apk update && apk upgrade && \
    apk add --no-cache \
    libc6-compat \
    wget \
    && rm -rf /var/cache/apk/*

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# -----------------------------------------------------------------------------
# Stage 2: Dependencies - Install all dependencies
# -----------------------------------------------------------------------------
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/marketing/package.json ./packages/marketing/

RUN pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 3: Builder - Build the Next.js application
# -----------------------------------------------------------------------------
FROM base AS builder

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/marketing/node_modules ./packages/marketing/node_modules

COPY packages/shared ./packages/shared
COPY packages/marketing ./packages/marketing
COPY tsconfig.json ./

# Build-time environment variables
ARG NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_GATEWAY_URL
ARG NEXT_PUBLIC_GTM_ID

ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL \
    NEXT_PUBLIC_GATEWAY_URL=$NEXT_PUBLIC_GATEWAY_URL \
    NEXT_PUBLIC_GTM_ID=$NEXT_PUBLIC_GTM_ID

RUN pnpm --filter shared build && \
    pnpm --filter marketing build

# -----------------------------------------------------------------------------
# Stage 4: Production - Minimal production image with standalone output
# -----------------------------------------------------------------------------
FROM node:22-alpine AS production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 campfire

RUN apk add --no-cache wget && rm -rf /var/cache/apk/*

WORKDIR /app

COPY --from=builder --chown=campfire:nodejs /app/packages/marketing/.next/standalone ./
COPY --from=builder --chown=campfire:nodejs /app/packages/marketing/.next/static ./packages/marketing/.next/static
COPY --from=builder --chown=campfire:nodejs /app/packages/marketing/public ./packages/marketing/public

USER campfire

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

ENV NODE_ENV=production \
    PORT=3001 \
    HOSTNAME=0.0.0.0

CMD ["node", "packages/marketing/server.js"]

# -----------------------------------------------------------------------------
# Stage 5: Development - Full development environment
# -----------------------------------------------------------------------------
FROM base AS development

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/marketing/node_modules ./packages/marketing/node_modules

COPY packages/shared ./packages/shared
COPY packages/marketing ./packages/marketing
COPY tsconfig.json ./

WORKDIR /app/packages/marketing

EXPOSE 3001

ENV NODE_ENV=development \
    PORT=3001

CMD ["pnpm", "dev"]
