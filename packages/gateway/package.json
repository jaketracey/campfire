{
  "name": "@campfire/gateway",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "predev": "pnpm db:migrate",
    "dev": "NODE_ENV=development tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:performance": "bash scripts/run-performance-tests.sh",
    "test:performance:api": "vitest run tests/performance/api-latency.test.ts",
    "test:performance:db": "vitest run tests/performance/database.test.ts",
    "test:performance:ws": "vitest run tests/performance/websocket.test.ts",
    "test:load": "bash scripts/run-load-tests.sh",
    "test:load:quick": "bash scripts/run-load-tests.sh quick",
    "test:load:standard": "bash scripts/run-load-tests.sh standard",
    "test:load:stress": "bash scripts/run-load-tests.sh stress",
    "test:stability": "vitest run tests/stability/",
    "test:stability:memory": "NODE_OPTIONS=--expose-gc vitest run tests/stability/memory-leak.test.ts",
    "test:stability:recovery": "vitest run tests/stability/recovery.test.ts",
    "test:e2e": "vitest run tests/e2e/",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node -e \"process.exit(require('fs').existsSync('../../.env')?0:1)\" && tsx --env-file=../../.env src/db/migrate.ts || tsx src/db/migrate.ts",
    "db:migrate:create": "node -e \"process.exit(require('fs').existsSync('../../.env')?0:1)\" && tsx --env-file=../../.env src/db/migrate.ts create || tsx src/db/migrate.ts create",
    "db:migrate:up": "node -e \"process.exit(require('fs').existsSync('../../.env')?0:1)\" && tsx --env-file=../../.env src/db/migrate.ts up || tsx src/db/migrate.ts up",
    "db:migrate:down": "node -e \"process.exit(require('fs').existsSync('../../.env')?0:1)\" && tsx --env-file=../../.env src/db/migrate.ts down || tsx src/db/migrate.ts down",
    "db:migrate:status": "node -e \"process.exit(require('fs').existsSync('../../.env')?0:1)\" && tsx --env-file=../../.env src/db/migrate.ts status || tsx src/db/migrate.ts status",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@campfire/shared": "workspace:*",
    "@elevenlabs/elevenlabs-js": "^2.35.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.56.0",
    "@opentelemetry/instrumentation-fastify": "^0.42.0",
    "@opentelemetry/instrumentation-pg": "^0.48.0",
    "@opentelemetry/resources": "^1.29.0",
    "@opentelemetry/sdk-node": "^0.56.0",
    "@opentelemetry/sdk-trace-node": "^1.29.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^10.35.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.30.0",
    "dockerode": "^4.0.9",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "otplib": "^13.1.1",
    "pino": "^10.2.1",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "stripe": "^20.3.1",
    "ws": "^8.18.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^22.19.3",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
