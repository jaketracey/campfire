{
  "name": "@campfire/orchestrator",
  "version": "0.2.6",
  "private": true,
  "scripts": {
    "dev": "bash scripts/python.sh -m uvicorn orchestrator.main:app --host 0.0.0.0 --port 8000 --reload --app-dir src",
    "start": "bash scripts/python.sh -m uvicorn orchestrator.main:app --host 0.0.0.0 --port 8000 --app-dir src",
    "test": "bash scripts/python.sh -m pytest",
    "lint": "bash scripts/python.sh -m ruff check src",
    "typecheck": "bash scripts/python.sh -m mypy src"
  }
}
